<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Manuxi\SuluAbbreviationsBundle\Entity\AbbreviationVersion" table="abbr_abbreviation_versions">
        <indexes>
            <index name="idx_abbr_version_lookup" columns="abbreviationId,locale,version"/>
        </indexes>

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="locale" type="string" column="locale" length="7"/>
        <field name="version" type="integer" column="version"/>
        <field name="data" type="json" column="data"/>
        <field name="created" type="datetime_immutable" column="created"/>

        <many-to-one field="abbreviation" target-entity="Manuxi\SuluAbbreviationsBundle\Entity\Abbreviation">
            <join-columns>
                <join-column name="abbreviationId" referenced-column-name="id" on-delete="CASCADE" nullable="false"/>
            </join-columns>
        </many-to-one>

        <many-to-one field="creator" target-entity="Sulu\Bundle\SecurityBundle\Entity\User">
            <join-columns>
                <join-column name="idUsersCreator" referenced-column-name="id" on-delete="SET NULL" nullable="true"/>
            </join-columns>
        </many-to-one>
    </entity>
</doctrine-mapping>
