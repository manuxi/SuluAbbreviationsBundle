<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Manuxi\SuluAbbreviationsBundle\Entity\AbbreviationDimensionContent" table="abbr_abbreviation_dimension_contents">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="name" type="string" column="name" length="255" nullable="true"/>

        <many-to-one field="abbreviation" target-entity="Manuxi\SuluAbbreviationsBundle\Entity\Abbreviation" inversed-by="dimensionContents">
            <join-columns>
                <join-column name="abbreviationId" referenced-column-name="id" on-delete="CASCADE" nullable="false"/>
            </join-columns>
        </many-to-one>
    </entity>
</doctrine-mapping>
