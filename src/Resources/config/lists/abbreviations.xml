<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>abbreviations</key>

    <joins name="dimensionContent">
        <join>
            <entity-name>dimensionContent</entity-name>
            <field-name>Manuxi\SuluAbbreviationsBundle\Entity\Abbreviation.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>dimensionContent.locale = :locale AND dimensionContent.stage = 'draft'</condition>
        </join>
    </joins>

    <joins name="unlocalizedDimensionContent">
        <join>
            <entity-name>unlocalizedDimensionContent</entity-name>
            <field-name>Manuxi\SuluAbbreviationsBundle\Entity\Abbreviation.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>unlocalizedDimensionContent.locale IS NULL AND unlocalizedDimensionContent.stage = 'draft'</condition>
        </join>
    </joins>

    <joins name="ghostDimensionContent" ref="unlocalizedDimensionContent">
        <join>
            <entity-name>ghostDimensionContent</entity-name>
            <field-name>Manuxi\SuluAbbreviationsBundle\Entity\Abbreviation.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>dimensionContent.locale IS NULL AND ghostDimensionContent.locale = unlocalizedDimensionContent.ghostLocale AND ghostDimensionContent.stage = 'draft'</condition>
        </join>
    </joins>

    <properties>
        <property name="id" visibility="no" translation="sulu_admin.id">
            <field-name>id</field-name>
            <entity-name>Manuxi\SuluAbbreviationsBundle\Entity\Abbreviation</entity-name>
        </property>

        <case-property name="name" translation="sulu_abbreviations.name" visibility="always" searchability="yes">
            <field>
                <field-name>name</field-name>
                <entity-name>dimensionContent</entity-name>

                <joins ref="dimensionContent"/>
            </field>

            <field>
                <field-name>name</field-name>
                <entity-name>ghostDimensionContent</entity-name>

                <joins ref="ghostDimensionContent"/>
            </field>

            <transformer type="title"/>
        </case-property>

        <property name="workflowPlace" translation="sulu_abbreviations.published_state" visibility="yes">
            <field-name>workflowPlace</field-name>
            <entity-name>dimensionContent</entity-name>

            <joins ref="dimensionContent"/>
        </property>

        <property name="workflowPublished" translation="sulu_abbreviations.published_date" type="datetime" visibility="yes">
            <field-name>workflowPublished</field-name>
            <entity-name>dimensionContent</entity-name>

            <joins ref="dimensionContent"/>
        </property>

        <property name="authored" translation="sulu_abbreviations.authored_date" type="datetime" visibility="no">
            <field-name>authored</field-name>
            <entity-name>dimensionContent</entity-name>

            <joins ref="dimensionContent"/>
        </property>

        <property name="locale" translation="sulu_admin.locale" visibility="never">
            <field-name>locale</field-name>
            <entity-name>dimensionContent</entity-name>

            <joins ref="dimensionContent"/>
        </property>

        <property name="ghostLocale" translation="sulu_admin.ghost_locale" visibility="never">
            <field-name>locale</field-name>
            <entity-name>ghostDimensionContent</entity-name>

            <joins ref="ghostDimensionContent"/>
        </property>
    </properties>
</list>
