{% extends "base.html.twig" %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-12 mb-3">
                <h2>{{ "sulu_abbreviations.name"|trans({}, 'admin') }}: {{ content.name }}</h2>
                <h3>{{ "sulu_abbreviations.explanation"|trans({}, 'admin') }}: {{ content.explanation }}</h3>
                {% if content.description %}
                    <strong>{{ "sulu_abbreviations.description"|trans({}, 'admin') }}:</strong>
                    <div>{{ content.description|raw }}</div>
                {% endif %}

                {% if content.image %}
                    {% set media = sulu_resolve_media(content.image.id, app.request.locale) %}
                    {% set abbreviationImage = media.thumbnails["sulu-240x"] %}
                    <img src="{{ asset(abbreviationImage) }}" class="img-thumbnail d-block" style="width:4rem;" alt="{{ content.explanation }}">
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
