{
    "name": "manuxi/sulu-abbreviations-bundle",
    "description": "Say hello to Sulu abbreviations!",
    "type": "symfony-bundle",
    "keywords": [
        "sulu",
        "suluCms",
        "sulu bundle",
        "abbreviations"
    ],
    "homepage": "https://github.com/manuxi/SuluAbbreviationsBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuxi",
            "email": "manu@bytefresser.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/doctrine-bundle": "^2.13",
        "massive/search-bundle": "^2.9",
        "sulu/content-bundle": "^0.8.3",
        "sulu/sulu": "^2.6",
        "symfony/config": "^6.4 | ^7.0",
        "symfony/console": "^6.4 | ^7.0",
        "symfony/dependency-injection": "^6.4 | ^7.0",
        "symfony/event-dispatcher": "^6.4 | ^7.0",
        "symfony/framework-bundle": "^6.4 | ^7.0",
        "symfony/http-foundation": "^6.4 | ^7.0",
        "symfony/http-kernel": "^6.4 | ^7.0",
        "symfony/intl": "^6.4 | ^7.0",
        "symfony/routing": "^6.4 | ^7.0",
        "symfony/security-core": "^6.4 | ^7.0",
        "symfony/translation": "^6.4 | ^7.0",
        "symfony/uid": "^6.4 | ^7.0",
        "symfony/workflow": "^6.4 | ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "handcraftedinthealps/zendsearch": "^2.0",
        "jackalope/jackalope-doctrine-dbal": "^1.3.4 | ^2.0",
        "phpspec/prophecy-phpunit": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "sulu/automation-bundle": "^2.1",
        "symfony/browser-kit": "^6.4 | ^7.0"
    },
    "suggest": {
        "sulu/automation-bundle": "Allows to schedule publishing and unpublishing of abbreviations"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluAbbreviationsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluAbbreviationsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        }
    }
}
